# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Supabase Postgres) ---
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"

# --- Cloudinary (private "raw" storage for PDFs) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET=""
# Canonical site URL. Local dev can leave this unset (defaults to localhost).
# On Vercel set it to the live custom domain so login callbacks/redirects and
# absolute URLs use it: AUTH_URL="https://lodhisociety.com"
AUTH_URL=""

# --- Health check (keeps Supabase free tier from auto-pausing) ---
# HEALTH_CHECK_SECRET: legacy manual/external-cron header (x-health-check-key).
# CRON_SECRET: read by Vercel Cron (see vercel.json) — Vercel auto-sends
# `Authorization: Bearer <CRON_SECRET>` on the scheduled request once this
# env var is set in the Vercel project settings. Either secret works.
HEALTH_CHECK_SECRET=""
CRON_SECRET=""
